# DealsCanada configuration.
#
# Every key below is OPTIONAL. With no .env at all the app runs on SQLite with
# conservative scraping defaults and the assistant hidden. Copy to `.env` and fill
# in only what you need.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Absent  -> SQLite at data/deals.db (default; nothing to install)
# Present -> Postgres. No code changes; this is the only switch.
# DATABASE_URL=postgres://user:pass@localhost:5432/dealscanada
# SQLITE_PATH=data/deals.db

# ---------------------------------------------------------------------------
# Scraping behaviour
# ---------------------------------------------------------------------------
# We identify ourselves honestly on every request. Keep a contact route in the UA.
# SCRAPE_USER_AGENT=DealsCanadaBot/0.1 (+https://github.com/mihirkhatri87/dealscanada)
# SCRAPE_CONCURRENCY=4
# RATE_LIMIT_RPS=1              # requests per second, per domain
# HTTP_TIMEOUT_MS=20000
# HTTP_MAX_RETRIES=3
# HTTP_CACHE_DIR=.cache/http
# HTTP_CACHE_TTL_MINUTES=60
# STALE_AFTER_MINUTES=180       # UI shows a staleness banner past this

# ---------------------------------------------------------------------------
# stocktrack.ca — in-store clearance near you
# ---------------------------------------------------------------------------
# A small independent site. We scrape only the stores you select, slowly, cached.
#
# OFF by default, and not just as caution: the paths this adapter uses are not
# real. /clearance/{storeId} and /stores/{chain} both 404 against the live site,
# which serves a JS app fetching from undocumented endpoints. There is no API
# and no terms page. Turning this on today only sends failing requests at a
# donation-funded hobby site; turn it on once you have real endpoints, ideally
# with the operator's blessing.
# STOCKTRACK_ENABLED=false
# STOCKTRACK_RATE_LIMIT_RPS=0.3
# STOCKTRACK_MAX_STORES=5

# ---------------------------------------------------------------------------
# Amazon Product Advertising API (optional, dormant without all three)
# ---------------------------------------------------------------------------
# Requires an Amazon Associates Canada account with 3 qualifying sales in 180 days.
# Without these, Amazon deals still arrive via camelcamelcamel and RedFlagDeals.
# AMAZON_ACCESS_KEY=
# AMAZON_SECRET_KEY=
# AMAZON_PARTNER_TAG=

# ---------------------------------------------------------------------------
# Canadian Tire family (Canadian Tire, SportChek, Mark's, Atmosphere, ...)
# ---------------------------------------------------------------------------
# Their platform expects a subscription key. There is NO public developer
# programme for one. Leave this unset and the family falls back to the JSON-LD
# engine, which needs no key.
# CANADIAN_TIRE_API_KEY=

# ---------------------------------------------------------------------------
# Affiliate product feeds
# ---------------------------------------------------------------------------
# The permitted route into retailers that will not be scraped. Once an affiliate
# application is approved, the network gives you a product feed URL; add it here
# keyed by the retailer's catalogue id and that source starts working.
#
# The URLs embed a publisher token, so treat this as a secret and never commit
# a filled-in value.
#
# Feeds carry gtin and mpn, which is why they are worth more than access alone:
# those identifiers are what let a deal be compared across merchants at all.
#
# AFFILIATE_FEEDS={"staples":"https://feeds.rakutenmarketing.com/…?token=…","best-buy":"https://…"}

# ---------------------------------------------------------------------------
# Shopping assistant (the only feature that needs a paid key)
# ---------------------------------------------------------------------------
# Without ANTHROPIC_API_KEY the assistant UI is absent and the site is unchanged.
# Default model is Sonnet 5 (~$0.05-0.12 per conversation); set to claude-opus-5
# if the S9.7 eval bake-off shows it earns the extra cost.
# ASSISTANT_ENABLED=true
# ANTHROPIC_API_KEY=sk-ant-...
# ASSISTANT_MODEL=claude-sonnet-5
# ASSISTANT_MAX_TOOL_CALLS=12
# ASSISTANT_MAX_TOKENS_PER_CONVERSATION=200000

# ---------------------------------------------------------------------------
# Scheduling
# ---------------------------------------------------------------------------
# SCRAPE_CRON=*/30 * * * *
# CRON_SECRET=                  # required by POST /api/cron/scrape when hosted
# CRON_BUDGET_MS=240000         # hosted run stops itself below the platform's ceiling

# ---------------------------------------------------------------------------
# Retirement
# ---------------------------------------------------------------------------
# A deal no source has returned for this long is retired. Generous on purpose:
# a gap is likelier a blocked scrape than an ended sale, and retiring a live
# deal is the worse of the two errors - nobody sees it at all.
# DEAD_AFTER_HOURS=72
# PRICE_HISTORY_DAYS=180        # older observations pruned, except each deal's newest

CRON=a10f32fa184846bfa4f6934e1c9d56d1